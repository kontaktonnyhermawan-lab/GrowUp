<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GrowUp – Smart Parenting App</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800;900&family=Nunito:ital,wght@0,400;0,600;0,700;0,800;0,900;1,700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #f0f4ff;
  --white: #ffffff;
  --shadow: 0 4px 20px rgba(0,0,0,0.07);
  --shadow-md: 0 8px 32px rgba(0,0,0,0.12);
  --radius: 22px;
  --radius-sm: 14px;
  --radius-xs: 10px;
  --text: #1a1d2e;
  --text-soft: #64748b;
  --border: #e8edf5;
  --green: #16a34a;
  --green-bg: #f0fdf4;
  --green-border: #86efac;
  --red: #ef4444;
  --red-bg: #fef2f2;

  /* Child palette — 6 colour slots */
  --c0: #7c3aed; --c0l: #ede9fe;
  --c1: #0284c7; --c1l: #e0f2fe;
  --c2: #d97706; --c2l: #fef3c7;
  --c3: #be185d; --c3l: #fce7f3;
  --c4: #059669; --c4l: #d1fae5;
  --c5: #dc2626; --c5l: #fee2e2;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:'Nunito',sans-serif;
  background:var(--bg);
  min-height:100vh;
  background-image:
    radial-gradient(ellipse at 10% 0%,rgba(167,139,250,.22) 0%,transparent 55%),
    radial-gradient(ellipse at 90% 100%,rgba(125,211,252,.18) 0%,transparent 55%);
}

/* ── LAYOUT ── */
.page{max-width:480px;margin:0 auto;padding:14px 14px 40px}

/* ── TOPBAR ── */
.topbar{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:14px;
}
.brand{display:flex;align-items:center;gap:8px}
.brand-logo{
  width:38px;height:38px;
  background:linear-gradient(135deg,#7c3aed,#6d28d9);
  border-radius:12px;
  display:flex;align-items:center;justify-content:center;
  font-size:20px;box-shadow:0 3px 10px rgba(109,40,217,.3);
}
.brand-name{font-family:'Baloo 2',sans-serif;font-size:20px;font-weight:900;color:var(--text)}
.brand-tag{font-size:10px;color:var(--text-soft);font-weight:700;letter-spacing:.5px;margin-top:-4px}
.topbar-actions{display:flex;gap:8px}
.icon-btn{
  width:38px;height:38px;border-radius:12px;
  background:var(--white);border:none;cursor:pointer;
  font-size:18px;display:flex;align-items:center;justify-content:center;
  box-shadow:var(--shadow);transition:all .2s;
}
.icon-btn:hover{transform:translateY(-1px);box-shadow:var(--shadow-md)}
.icon-btn:active{transform:scale(.93)}

/* ── PROFILES ROW ── */
.profiles-scroll{overflow-x:auto;margin-bottom:14px;padding-bottom:4px}
.profiles-scroll::-webkit-scrollbar{display:none}
.profiles-row{display:flex;gap:10px;width:max-content;padding:2px 2px}
.profile-chip{
  display:flex;flex-direction:column;align-items:center;gap:5px;
  cursor:pointer;transition:transform .2s;min-width:68px;
}
.profile-chip:hover{transform:translateY(-2px)}
.profile-chip:active{transform:scale(.94)}
.profile-avatar{
  width:56px;height:56px;border-radius:18px;
  display:flex;align-items:center;justify-content:center;
  font-size:28px;position:relative;
  border:3px solid transparent;
  transition:all .25s;
  background:#e8edf5;
}
.profile-avatar.active{border-color:var(--pc,#7c3aed);box-shadow:0 4px 14px rgba(0,0,0,.15);}
.profile-avatar .badge-done{
  position:absolute;bottom:-4px;right:-4px;
  background:#22c55e;color:white;
  font-size:9px;font-weight:900;padding:2px 5px;border-radius:99px;
  border:2px solid var(--bg);
}
.profile-name{font-size:12px;font-weight:800;color:var(--text);text-align:center;max-width:68px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.profile-add{
  width:56px;height:56px;border-radius:18px;
  border:2.5px dashed #c7d2e7;
  background:rgba(255,255,255,.6);
  display:flex;align-items:center;justify-content:center;
  font-size:26px;color:#94a3b8;cursor:pointer;
  transition:all .2s;
}
.profile-add:hover{border-color:#7c3aed;color:#7c3aed;background:rgba(124,58,237,.06)}

/* ── HEADER CARD ── */
.header-card{
  border-radius:26px;padding:20px;color:white;
  margin-bottom:14px;position:relative;overflow:hidden;
  box-shadow:var(--shadow-md);
}
.hc-bg1{position:absolute;top:-50px;right:-50px;width:180px;height:180px;background:rgba(255,255,255,.08);border-radius:50%}
.hc-bg2{position:absolute;bottom:-60px;left:-20px;width:140px;height:140px;background:rgba(255,255,255,.06);border-radius:50%}
.hc-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;position:relative;z-index:1}
.hc-child{display:flex;align-items:center;gap:10px}
.hc-avatar{width:44px;height:44px;border-radius:14px;background:rgba(255,255,255,.25);display:flex;align-items:center;justify-content:center;font-size:24px}
.hc-info h2{font-family:'Baloo 2',sans-serif;font-size:18px;font-weight:900;margin-bottom:1px}
.hc-info p{font-size:12px;opacity:.8}
.hc-edit{background:rgba(255,255,255,.2);border:none;color:white;border-radius:99px;padding:5px 12px;font-size:12px;font-weight:800;cursor:pointer;font-family:'Nunito';transition:background .2s}
.hc-edit:hover{background:rgba(255,255,255,.35)}

.date-nav{display:flex;align-items:center;gap:8px;position:relative;z-index:1}
.dn-btn{background:rgba(255,255,255,.2);border:none;color:white;border-radius:50%;width:34px;height:34px;cursor:pointer;font-size:18px;display:flex;align-items:center;justify-content:center;transition:background .2s;flex-shrink:0}
.dn-btn:hover{background:rgba(255,255,255,.35)}
.dn-btn:active{transform:scale(.9)}
.dn-btn:disabled{opacity:.3;cursor:default}
.dn-date{flex:1;text-align:center}
.dn-day{font-family:'Baloo 2',sans-serif;font-size:17px;font-weight:800}
.dn-full{font-size:12px;opacity:.8}
.today-pill{background:rgba(255,255,255,.22);border-radius:99px;padding:3px 10px;font-size:10px;font-weight:900;letter-spacing:.8px}

.progress-block{background:rgba(255,255,255,.15);border-radius:16px;padding:13px 15px;margin-top:14px;position:relative;z-index:1}
.pb-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px}
.pb-label{font-size:13px;font-weight:700}
.pb-pct{font-family:'Baloo 2',sans-serif;font-size:24px;font-weight:900}
.pb-track{background:rgba(255,255,255,.25);border-radius:99px;height:11px;overflow:hidden;margin-bottom:9px}
.pb-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,#fde68a,#fbbf24,#f59e0b);transition:width .6s cubic-bezier(.34,1.56,.64,1);position:relative;overflow:hidden}
.pb-fill::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.4),transparent);animation:sh 2.2s infinite}
@keyframes sh{from{transform:translateX(-100%)}to{transform:translateX(200%)}}
.stars-row{display:flex;justify-content:center;gap:3px;font-size:20px}
.star{transition:transform .3s}
.star.lit{animation:starPop .4s ease both}
@keyframes starPop{0%{transform:scale(0)}70%{transform:scale(1.35)}100%{transform:scale(1)}}

/* ── CELEBRATION ── */
.celebration{
  background:linear-gradient(135deg,#fbbf24,#f97316,#ef4444);
  border-radius:var(--radius);padding:15px;text-align:center;
  color:white;font-size:15px;font-weight:900;margin-bottom:12px;
  animation:celeb 2s ease-in-out infinite;box-shadow:0 6px 24px rgba(249,115,22,.4);
}
@keyframes celeb{0%,100%{transform:scale(1)}50%{transform:scale(1.02)}}

/* ── SECTION ── */
.section-hdr{display:flex;align-items:center;gap:8px;margin:18px 0 8px;padding:0 2px}
.section-icon{font-size:18px}
.section-title{font-size:12px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase}
.section-line{flex:1;height:1.5px;border-radius:99px;opacity:.25}
.morning .section-title,.morning .section-line{color:#c2410c;background:#c2410c}
.afternoon .section-title,.afternoon .section-line{color:#a16207;background:#a16207}
.evening .section-title,.evening .section-line{color:#0369a1;background:#0369a1}
.night .section-title,.night .section-line{color:#6d28d9;background:#6d28d9}

/* ── CARDS ── */
.act-card{
  background:var(--white);border-radius:var(--radius);padding:13px 14px;
  margin-bottom:8px;display:flex;align-items:center;gap:11px;
  cursor:pointer;transition:transform .15s,box-shadow .15s,background .3s;
  border:2px solid transparent;position:relative;box-shadow:var(--shadow);
  animation:cardIn .3s ease both;
}
@keyframes cardIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.act-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-md)}
.act-card:active{transform:scale(.98)}
.act-card.done{background:var(--green-bg);border-color:var(--green-border)}
.act-card.done .act-name{text-decoration:line-through;color:#86efac}
.act-card.done .act-desc{color:#bbf7d0}
.act-card.active-now{border-color:#fb923c;box-shadow:0 0 0 3px rgba(251,146,60,.18),var(--shadow)}
.now-pill{position:absolute;top:-9px;right:14px;background:linear-gradient(90deg,#fb923c,#f97316);color:white;font-size:9px;font-weight:900;padding:2px 9px;border-radius:99px;letter-spacing:.5px;box-shadow:0 2px 8px rgba(249,115,22,.4)}
.time-badge{font-size:11px;font-weight:800;padding:4px 8px;border-radius:99px;min-width:50px;text-align:center;flex-shrink:0;font-family:'Baloo 2',sans-serif}
.tb-morning{background:#fff7ed;color:#c2410c}
.tb-afternoon{background:#fefce8;color:#a16207}
.tb-evening{background:#e0f2fe;color:#0369a1}
.tb-night{background:#f5f3ff;color:#6d28d9}
.act-emoji{font-size:28px;width:36px;text-align:center;flex-shrink:0}
.act-info{flex:1;min-width:0}
.act-name{font-size:14px;font-weight:800;color:var(--text);transition:color .3s;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.act-desc{font-size:12px;color:var(--text-soft);margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.act-actions{display:flex;align-items:center;gap:6px}
.del-btn{width:26px;height:26px;border-radius:50%;border:none;background:var(--red-bg);color:var(--red);font-size:13px;cursor:pointer;display:none;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0}
.act-card:hover .del-btn{display:flex}
.del-btn:hover{background:var(--red);color:white;transform:scale(1.1)}
.check-btn{width:32px;height:32px;border-radius:50%;border:2.5px solid var(--border);background:var(--white);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:15px;transition:all .25s cubic-bezier(.34,1.56,.64,1);flex-shrink:0;color:white;font-weight:900}
.check-btn.done{background:#22c55e;border-color:#22c55e;box-shadow:0 2px 10px rgba(34,197,94,.4);transform:scale(1.05)}
.check-btn:hover{transform:scale(1.12)}

/* ── BOTTOM BAR ── */
.bottom-bar{display:flex;gap:10px;margin-top:18px}
.ac-btn{flex:1;padding:13px;border:none;border-radius:var(--radius-sm);font-size:13px;font-weight:800;cursor:pointer;font-family:'Nunito';transition:all .2s}
.ac-btn:active{transform:scale(.96)}
.btn-add-act{color:white;box-shadow:0 4px 16px rgba(109,40,217,.3)}
.btn-reset{background:var(--white);color:var(--red);border:2px solid #fecaca;box-shadow:var(--shadow)}
.btn-reset:hover{background:var(--red-bg)}

/* ── MODALS ── */
.overlay{position:fixed;inset:0;background:rgba(10,8,30,.55);display:flex;align-items:flex-end;justify-content:center;z-index:500;animation:ovIn .2s ease}
.overlay.center{align-items:center;padding:20px}
@keyframes ovIn{from{opacity:0}to{opacity:1}}
.sheet{background:var(--white);border-radius:28px 28px 0 0;padding:22px 20px 40px;width:100%;max-width:480px;animation:sheetUp .3s cubic-bezier(.34,1.56,.64,1)}
.sheet.center-modal{border-radius:var(--radius);padding:24px 22px;animation:popIn .3s cubic-bezier(.34,1.56,.64,1)}
@keyframes sheetUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
@keyframes popIn{from{transform:scale(.85);opacity:0}to{transform:scale(1);opacity:1}}
.sheet-handle{width:40px;height:4px;background:var(--border);border-radius:99px;margin:0 auto 18px}
.sheet h3{font-family:'Baloo 2',sans-serif;font-size:19px;font-weight:900;color:var(--text);margin-bottom:18px}
.form-row{display:flex;gap:10px}
.form-g{margin-bottom:13px;flex:1}
.form-g label{font-size:11px;font-weight:900;color:var(--text-soft);display:block;margin-bottom:5px;letter-spacing:.6px;text-transform:uppercase}
.form-g input,.form-g select,.form-g textarea{width:100%;padding:11px 13px;border:2px solid var(--border);border-radius:var(--radius-xs);font-size:14px;font-family:'Nunito';outline:none;transition:border-color .2s,box-shadow .2s;color:var(--text);background:var(--white)}
.form-g input:focus,.form-g select:focus,.form-g textarea:focus{border-color:#7c3aed;box-shadow:0 0 0 3px rgba(124,58,237,.1)}
.emoji-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:5px;margin-bottom:13px}
.eg-opt{width:36px;height:36px;border-radius:9px;border:2px solid var(--border);background:#f8fafc;font-size:19px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s}
.eg-opt:hover{background:#f0e7ff;border-color:#c4b5fd;transform:scale(1.1)}
.eg-opt.sel{background:#ede9fe;border-color:#7c3aed;transform:scale(1.12)}
.color-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:4px}
.color-dot{width:32px;height:32px;border-radius:50%;cursor:pointer;border:3px solid transparent;transition:all .2s;position:relative}
.color-dot.sel::after{content:'✓';position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:white;font-size:13px;font-weight:900}
.color-dot:hover{transform:scale(1.15)}
.modal-btns{display:flex;gap:10px;margin-top:18px}
.modal-btns button{flex:1;padding:13px;border-radius:var(--radius-xs);border:none;font-size:14px;font-weight:800;cursor:pointer;font-family:'Nunito';transition:all .2s}
.modal-btns button:active{transform:scale(.96)}
.mbtn-save{color:white;box-shadow:0 4px 14px rgba(109,40,217,.3)}
.mbtn-cancel{background:#f1f5f9;color:var(--text-soft)}
.mbtn-danger{background:var(--red-bg);color:var(--red)}

/* ── ONBOARDING ── */
.onboard{position:fixed;inset:0;background:white;z-index:1000;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px 24px;text-align:center;animation:fadeIn .5s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.ob-logo{width:80px;height:80px;background:linear-gradient(135deg,#7c3aed,#6d28d9);border-radius:28px;display:flex;align-items:center;justify-content:center;font-size:42px;margin:0 auto 20px;box-shadow:0 8px 32px rgba(109,40,217,.4)}
.ob-logo-pulse{animation:logoPulse 2s ease-in-out infinite}
@keyframes logoPulse{0%,100%{box-shadow:0 8px 32px rgba(109,40,217,.4)}50%{box-shadow:0 12px 48px rgba(109,40,217,.6)}}
.ob h1{font-family:'Baloo 2',sans-serif;font-size:32px;font-weight:900;color:var(--text);margin-bottom:6px}
.ob p{font-size:15px;color:var(--text-soft);font-weight:600;margin-bottom:36px;line-height:1.6}
.ob-input{width:100%;padding:15px;border:2.5px solid var(--border);border-radius:var(--radius-sm);font-size:18px;font-weight:800;font-family:'Nunito';text-align:center;outline:none;color:var(--text);margin-bottom:14px;transition:border-color .2s}
.ob-input:focus{border-color:#7c3aed;box-shadow:0 0 0 4px rgba(124,58,237,.1)}
.ob-emoji-row{display:flex;gap:10px;justify-content:center;margin-bottom:24px;flex-wrap:wrap}
.ob-emoji{width:52px;height:52px;border-radius:16px;border:2.5px solid var(--border);background:#f8fafc;font-size:26px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s}
.ob-emoji:hover{border-color:#7c3aed;background:#ede9fe;transform:scale(1.1)}
.ob-emoji.sel{border-color:#7c3aed;background:#ede9fe;transform:scale(1.12)}
.ob-start{width:100%;padding:16px;background:linear-gradient(135deg,#7c3aed,#6d28d9);color:white;border:none;border-radius:var(--radius-sm);font-size:17px;font-weight:900;cursor:pointer;font-family:'Nunito';box-shadow:0 6px 24px rgba(109,40,217,.4);transition:all .2s}
.ob-start:hover{transform:translateY(-2px);box-shadow:0 10px 32px rgba(109,40,217,.5)}
.ob-start:active{transform:scale(.97)}
.ob-skip{margin-top:14px;font-size:13px;color:var(--text-soft);cursor:pointer;font-weight:700}
.ob-skip:hover{color:var(--text)}
.ob-features{display:flex;flex-direction:column;gap:10px;margin-bottom:32px;text-align:left;width:100%}
.ob-feat{display:flex;align-items:center;gap:12px;background:#f8fafc;border-radius:14px;padding:12px 14px}
.ob-feat-icon{font-size:22px;flex-shrink:0}
.ob-feat-text strong{font-size:14px;font-weight:800;color:var(--text);display:block}
.ob-feat-text span{font-size:12px;color:var(--text-soft)}
.ob-step{display:none}
.ob-step.active{display:block}
.ob-dots{display:flex;gap:6px;justify-content:center;margin-bottom:28px}
.ob-dot{width:8px;height:8px;border-radius:50%;background:var(--border);transition:all .3s}
.ob-dot.active{background:#7c3aed;width:24px;border-radius:99px}

/* ── SETTINGS SHEET ── */
.settings-item{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--border);cursor:pointer;transition:background .2s}
.settings-item:last-child{border:none}
.si-left{display:flex;align-items:center;gap:12px}
.si-icon{width:38px;height:38px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px}
.si-text strong{font-size:14px;font-weight:800;color:var(--text);display:block}
.si-text span{font-size:12px;color:var(--text-soft)}
.si-arrow{font-size:16px;color:var(--text-soft)}

/* ── MANAGE CHILDREN ── */
.child-manage-item{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--border)}
.child-manage-item:last-child{border:none}
.cmi-avatar{width:44px;height:44px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0}
.cmi-info{flex:1}
.cmi-name{font-size:15px;font-weight:800;color:var(--text)}
.cmi-acts{font-size:12px;color:var(--text-soft)}
.cmi-btns{display:flex;gap:6px}
.cmi-btn{width:32px;height:32px;border-radius:10px;border:none;cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;transition:all .2s}
.cmi-edit{background:#ede9fe;color:#7c3aed}
.cmi-del{background:var(--red-bg);color:var(--red)}
.cmi-btn:hover{transform:scale(1.1)}

/* ── EMPTY ── */
.empty-state{text-align:center;padding:40px 20px;color:var(--text-soft)}
.empty-state .big{font-size:56px;margin-bottom:12px}
.empty-state p{font-size:15px;font-weight:700}

/* ── FOOTER ── */
.app-footer{text-align:center;margin-top:28px;font-size:12px;color:var(--text-soft);font-weight:600;line-height:1.8}
.app-footer strong{color:var(--text)}

@media(max-width:380px){
  .act-emoji{font-size:22px;width:28px}
  .time-badge{font-size:10px;min-width:44px;padding:3px 6px}
  .profile-avatar{width:50px;height:50px;border-radius:15px}
}
</style>
</head>
<body>

<div class="page" id="root"></div>

<script>
// ══════════════════════════════════════════
// CONSTANTS
// ══════════════════════════════════════════
const SK = 'GrowUp-v2';

const CHILD_COLORS = [
  '#7c3aed','#0284c7','#d97706','#be185d','#059669','#dc2626'
];
const CHILD_COLORS_LIGHT = [
  '#ede9fe','#e0f2fe','#fef3c7','#fce7f3','#d1fae5','#fee2e2'
];

const AVATAR_OPTS = ['👧','👦','🧒','👶','🦸','🧑'];

const EMOJI_OPTS = [
  '🌅','🕌','🚿','🍳','👔','🏫','📚','✏️',
  '⚽','🏊','🍽️','😴','🕐','🌙','🌃','🍜',
  '📖','🦷','🙏','🎨','🎮','🎯','🏃','🧘',
