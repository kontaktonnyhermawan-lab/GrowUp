              <option value="morning">☀️ Pagi</option>
              <option value="afternoon">🌤️ Siang</option>
              <option value="evening">🌇 Sore</option>
              <option value="night">🌙 Malam</option>
            </select>
          </div>
        </div>
        <div class="form-g"><label>Keterangan (opsional)</label><input id="m-desc" placeholder="Catatan singkat..." maxlength="60"></div>
        <div class="modal-btns">
          <button class="mbtn-cancel" onclick="closeModal()">Batal</button>
          <button class="mbtn-save" style="background:${pc}" onclick="saveActivity()">💾 Simpan</button>
        </div>
      </div>
    </div>`;
  }

  if(S.modal==='addChild'){
    const colorDots=CHILD_COLORS.map((c,i)=>`<div class="color-dot${i===S.selColor?' sel':''}" style="background:${c}" onclick="selectColor(${i})"></div>`).join('');
    const avOpts=AVATAR_OPTS.map(a=>`<div class="ob-emoji av-opt${a===S.selAvatar?' sel':''}" data-a="${a}" onclick="S.selAvatar='${a}';selectAvatar('${a}')">${a}</div>`).join('');
    html+=`<div class="overlay" onclick="if(event.target===this)closeModal()">
      <div class="sheet">
        <div class="sheet-handle"></div>
        <h3>👧 Tambah Profil Anak</h3>
        <div class="form-g"><label>Nama Anak</label><input id="ac-name" placeholder="Masukkan nama anak..." maxlength="20"></div>
        <div class="form-g"><label>Pilih Avatar</label>
          <div class="ob-emoji-row" style="justify-content:flex-start;margin-bottom:0">${avOpts}</div>
        </div>
        <div class="form-g"><label>Warna Profil</label><div class="color-row">${colorDots}</div></div>
        <div class="modal-btns">
          <button class="mbtn-cancel" onclick="closeModal()">Batal</button>
          <button class="mbtn-save" style="background:#7c3aed" onclick="addChild()">➕ Tambahkan</button>
        </div>
      </div>
    </div>`;
  }

  if(S.modal==='editChild'&&S.editChildId){
    const ec=getChild(S.editChildId);
    const colorDots=CHILD_COLORS.map((c,i)=>`<div class="color-dot${i===S.selColor?' sel':''}" style="background:${c}" onclick="selectColor(${i})"></div>`).join('');
    const avOpts=AVATAR_OPTS.map(a=>`<div class="ob-emoji av-opt${a===S.selAvatar?' sel':''}" data-a="${a}" onclick="S.selAvatar='${a}';selectAvatar('${a}')">${a}</div>`).join('');
    html+=`<div class="overlay" onclick="if(event.target===this)closeModal()">
      <div class="sheet">
        <div class="sheet-handle"></div>
        <h3>✏️ Edit Profil ${esc(ec?.name||'')}</h3>
        <div class="form-g"><label>Nama Anak</label><input id="ec-name" value="${esc(ec?.name||'')}" maxlength="20"></div>
        <div class="form-g"><label>Pilih Avatar</label>
          <div class="ob-emoji-row" style="justify-content:flex-start;margin-bottom:0">${avOpts}</div>
        </div>
        <div class="form-g"><label>Warna Profil</label><div class="color-row">${colorDots}</div></div>
        <div class="modal-btns">
          <button class="mbtn-danger" onclick="deleteChild('${S.editChildId}')">🗑️ Hapus</button>
          <button class="mbtn-save" style="background:${pc}" onclick="saveEditChild()">💾 Simpan</button>
        </div>
      </div>
    </div>`;
  }

  if(S.modal==='settings'){
    const manageHtml=S.children.map(c=>{
      const cp=childColor(c);
      const actsCount=(S.activities[c.id]||[]).length;
      return`<div class="child-manage-item">
        <div class="cmi-avatar" style="background:${childColorLight(c)}">${c.avatar}</div>
        <div class="cmi-info">
          <div class="cmi-name">${esc(c.name)}</div>
          <div class="cmi-acts">${actsCount} kegiatan terdaftar</div>
        </div>
        <div class="cmi-btns">
          <button class="cmi-btn cmi-edit" onclick="closeModal();openEditChild('${c.id}')">✏️</button>
          ${S.children.length>1?`<button class="cmi-btn cmi-del" onclick="deleteChild('${c.id}')">🗑️</button>`:''}
        </div>
      </div>`;
    }).join('');
    html+=`<div class="overlay" onclick="if(event.target===this)closeModal()">
      <div class="sheet">
        <div class="sheet-handle"></div>
        <h3>⚙️ Pengaturan</h3>
        <div style="font-size:12px;font-weight:900;color:#64748b;letter-spacing:.8px;margin-bottom:10px">PROFIL ANAK</div>
        ${manageHtml}
        <button class="ac-btn btn-add-act" style="background:#7c3aed;margin-top:14px;width:100%;padding:12px" onclick="openAddChild()">＋ Tambah Profil Anak Baru</button>
        <div style="margin-top:20px;padding:14px;background:#fef3c7;border-radius:14px;border-left:4px solid #f59e0b">
          <div style="font-size:13px;font-weight:800;color:#92400e;margin-bottom:4px">💡 Tips Penjualan</div>
          <div style="font-size:12px;color:#78350f;line-height:1.6">Aplikasi ini support hingga banyak anak. Cocok untuk keluarga dengan beberapa anak atau dijual ke sekolah/PAUD sebagai tools monitoring siswa.</div>
        </div>
        <div class="modal-btns"><button class="mbtn-cancel" style="flex:none;width:100%" onclick="closeModal()">Tutup</button></div>
      </div>
    </div>`;
  }

  return html;
}

function openAddChild(){
  S.selColor=S.children.length % CHILD_COLORS.length;
  S.selAvatar='👧';
  S.modal='addChild';
  render();
}

// ══════════════════════════════════════════
// INIT
// ══════════════════════════════════════════
hydrate();
render();
setInterval(()=>{ if(!S.onboard&&isToday(S.viewDate)) render(); },60000);
</script>
</body>
</html>
