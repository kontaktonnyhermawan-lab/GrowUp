// ══════════════════════════════════════════
// PERSIST
// ══════════════════════════════════════════
function persist() {
  if (S.activeId) {
    const key = dkey(new Date());
    if (!S.perDayDone[S.activeId]) S.perDayDone[S.activeId]={};
    S.perDayDone[S.activeId][key] = (S.activities[S.activeId]||[]).filter(a=>a.done).map(a=>a.id);
  }
  const save = {
    children:   S.children,
    activeId:   S.activeId,
    activities: {},
    perDayDone: S.perDayDone,
  };
  // strip done flags for storage
  Object.keys(S.activities).forEach(cid=>{
    save.activities[cid] = (S.activities[cid]||[]).map(a=>({...a,done:false}));
  });
  try{ localStorage.setItem(SK,JSON.stringify(save)); }catch(e){}
}

function hydrate() {
  try{
    const raw = localStorage.getItem(SK);
    if(!raw) return;
    const d = JSON.parse(raw);
    S.children   = d.children   || [];
    S.activeId   = d.activeId   || null;
    S.activities = d.activities  || {};
    S.perDayDone = d.perDayDone  || {};
    if(S.children.length){S.onboard=false; syncDone(S.viewDate);}
  }catch(e){}
}

function syncDone(d) {
  const cid = S.activeId;
  if(!cid) return;
  const ids = (S.perDayDone[cid]||{})[dkey(d)]||[];
  if(S.activities[cid]){
    S.activities[cid]=S.activities[cid].map(a=>({...a,done:ids.includes(a.id)}));
  }
}

// ══════════════════════════════════════════
// HELPERS
// ══════════════════════════════════════════
function dkey(d){return d.toISOString().slice(0,10)}
function isToday(d){return d.toDateString()===new Date().toDateString()}
function toMin(t){const[h,m]=t.split(':').map(Number);return h*60+m}
function nowMin(){const n=new Date();return n.getHours()*60+n.getMinutes()}
function nextId(arr){return arr.length?Math.max(...arr.map(a=>a.id))+1:1}
function uid(){return '_'+Math.random().toString(36).slice(2,9)}
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}

function childColor(c){return CHILD_COLORS[c?.colorIdx||0]}
function childColorLight(c){return CHILD_COLORS_LIGHT[c?.colorIdx||0]}

function getChild(id){return S.children.find(c=>c.id===id)}
function activeChild(){return getChild(S.activeId)}

function getActs(){return S.activities[S.activeId]||[]}

function getDone(d){
  const cid=S.activeId;
  if(!cid) return 0;
  if(isToday(d)) return getActs().filter(a=>a.done).length;
  return ((S.perDayDone[cid]||{})[dkey(d)]||[]).length;
}
function getPct(d){const t=getActs().length;return t?Math.round(getDone(d)/t*100):0}
function getStarCount(p){
  if(p>=100)return 5;if(p>=80)return 4;if(p>=60)return 3;if(p>=40)return 2;if(p>=20)return 1;return 0;
}
function childPct(cid,d){
  const acts=S.activities[cid]||[];
  if(!acts.length) return 0;
  const done=isToday(d)?acts.filter(a=>a.done).length:((S.perDayDone[cid]||{})[dkey(d)]||[]).length;
  return Math.round(done/acts.length*100);
}

function currentActId(){
  if(!isToday(S.viewDate)||!S.activeId) return null;
  const now=nowMin();
  const sorted=[...getActs()].sort((a,b)=>toMin(a.time)-toMin(b.time));
  for(let i=0;i<sorted.length;i++){
    const s=toMin(sorted[i].time);
    const e=sorted[i+1]?toMin(sorted[i+1].time):s+60;
    if(now>=s&&now<e) return sorted[i].id;
  }
  return null;
}

function fmtDate(d){return`${d.getDate()} ${MONTHS_ID[d.getMonth()]} ${d.getFullYear()}`}

// ══════════════════════════════════════════
// ACTIONS
// ══════════════════════════════════════════
function switchChild(id){
  S.activeId=id;
  S.viewDate=new Date();
  syncDone(S.viewDate);
  render();
}

function toggleDone(id){
  const acts=S.activities[S.activeId];
  if(!acts) return;
  S.activities[S.activeId]=acts.map(a=>a.id===id?{...a,done:!a.done}:a);
  persist(); render();
}

function deleteAct(id){
  if(!confirm('Hapus kegiatan ini?')) return;
  S.activities[S.activeId]=(S.activities[S.activeId]||[]).filter(a=>a.id!==id);
  persist(); render();
}

function changeDate(delta){
  const d=new Date(S.viewDate);
  d.setDate(d.getDate()+delta);
  S.viewDate=d;
  syncDone(d);
  render();
}

function resetDay(){
  if(!confirm('Reset semua centang hari ini?')) return;
  S.activities[S.activeId]=(S.activities[S.activeId]||[]).map(a=>({...a,done:false}));
  const cid=S.activeId;
  if(!S.perDayDone[cid]) S.perDayDone[cid]={};
  S.perDayDone[cid][dkey(new Date())]=[];
  persist(); render();
}

function openModal(m){S.modal=m;render()}
function closeModal(){S.modal=null;S.editChildId=null;render()}

function selectEmoji(e){
  S.selectedEmoji=e;
  document.querySelectorAll('.eg-opt').forEach(el=>el.classList.toggle('sel',el.dataset.e===e));
  const inp=document.getElementById('m-emoji');
  if(inp) inp.value=e;
}

function saveActivity(){
  const name=(document.getElementById('m-name')?.value||'').trim();
  if(!name){alert('Nama kegiatan harus diisi!');return}
  const act={
    id:nextId(getActs()),
    emoji:document.getElementById('m-emoji')?.value||S.selectedEmoji||'⭐',
    name,
    time:document.getElementById('m-time')?.value||'08:00',
    session:document.getElementById('m-session')?.value||'morning',
    desc:(document.getElementById('m-desc')?.value||'').trim(),
    done:false,
  };
  if(!S.activities[S.activeId]) S.activities[S.activeId]=[];
  S.activities[S.activeId].push(act);
  S.activities[S.activeId].sort((a,b)=>toMin(a.time)-toMin(b.time));
  persist(); S.modal=null; render();
}

function openEditChild(id){
  S.editChildId=id;
  const c=getChild(id);
  S.selAvatar=c.avatar;
  S.selColor=c.colorIdx||0;
  S.modal='editChild';
  render();
}

function saveEditChild(){
  const name=(document.getElementById('ec-name')?.value||'').trim();
  if(!name){alert('Nama anak harus diisi!');return}
  S.children=S.children.map(c=>c.id===S.editChildId?{...c,name,avatar:S.selAvatar,colorIdx:S.selColor}:c);
  persist(); S.modal=null; S.editChildId=null; render();
}

function deleteChild(id){
  if(S.children.length<=1){alert('Minimal harus ada 1 anak.');return}
  if(!confirm('Hapus profil anak ini beserta semua jadwalnya?')) return;
  S.children=S.children.filter(c=>c.id!==id);
  delete S.activities[id];
  delete S.perDayDone[id];
  if(S.activeId===id) S.activeId=S.children[0]?.id||null;
  persist(); S.modal=null; render();
}

function addChild(){
  const name=(document.getElementById('ac-name')?.value||'').trim();
  if(!name){alert('Nama anak harus diisi!');return}
  const id=uid();
  const ci=S.selColor;
  S.children.push({id,name,avatar:S.selAvatar,colorIdx:ci});
  S.activities[id]=DEFAULT_ACTS.map((a,i)=>({...a,id:i+1,done:false}));
  S.activeId=id;
  S.viewDate=new Date();
  syncDone(S.viewDate);
  persist(); S.modal=null; render();
}

function selectColor(i){
  S.selColor=i;
  document.querySelectorAll('.color-dot').forEach((el,j)=>el.classList.toggle('sel',j===i));
}

function selectAvatar(a){
  S.selAvatar=a;
  document.querySelectorAll('.ob-emoji,.av-opt').forEach(el=>el.classList.toggle('sel',el.dataset.a===a));
